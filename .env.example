# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube al repositorio.

# --- Notificaciones por correo (M3-06) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=genera_una_contrase_a_de_aplicaci_n
# FROM_EMAIL=tu_correo@gmail.com
# FROM_NAME=Campus Parking

# --- Seguridad ---
# Clave secreta de sesión (genera una larga y aleatoria):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_en_produccion

# Desactiva la protección CSRF (solo para pruebas automatizadas):
CSRF_OFF=0

# --- Ejecución ---
# Activa el modo debug del servidor web (solo desarrollo):
FLASK_DEBUG=0
# Puerto del servidor:
PORT=5050