# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube al repositorio.

# --- Notificaciones por correo (M3-06) ---
# Email Configuration (Recommended - Gmail)
EMAIL_ADDRESS=jhonadevalmanza@gmail.com
EMAIL_PASSWORD=

# Alternative SMTP Configuration (optional, EMAIL_ADDRESS takes priority)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Campus Parking

# --- Seguridad ---
# Clave secreta de sesion (genera una larga y aleatoria):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_en_produccion

# Desactiva la proteccion CSRF (solo para pruebas automatizadas):
CSRF_OFF=0

# --- Ejecucion ---
# Activa el modo debug del servidor web (solo desarrollo):
FLASK_DEBUG=0
# Puerto del servidor:
PORT=5050

# Contraseñas del personal (pantalla /personal). Vacía = cuenta deshabilitada.
ADMIN_PASSWORD=
PORTERIA_PASSWORD=
